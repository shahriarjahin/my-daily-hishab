# Required server environment variables
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Generate once; preserve this same value in development and production.
HISHAB_SECRET_KEY=

# Optional server-provided AI key, restricted to this account email
GOOGLE_API_KEY=
HISHAB_OWNER_EMAIL=
GEMINI_MODEL=gemini-flash-latest

# Optional backup providers; private keys can also be added in Settings
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
COHERE_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
