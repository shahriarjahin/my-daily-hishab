# Required server environment variables
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Generate once; preserve this same value in development and production.
HISHAB_SECRET_KEY=

# Direct PostgreSQL connection string for fast relational mode (<50ms saves).
# Obtain from Supabase Dashboard -> Project Settings -> Database -> Connection string (Connection pooling / Transaction mode, port 6543)
# Example: postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=

# Optional server-provided AI key, restricted to this account email
GOOGLE_API_KEY=
HISHAB_OWNER_EMAIL=
GEMINI_MODEL=gemini-flash-latest

# Optional backup providers; private keys can also be added in Settings
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
COHERE_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# Production origin for email / OAuth callbacks; leave unset for local development
HISHAB_PUBLIC_URL=
# Enable only after upgrading Android clients; see docs/ACCOUNT_SETUP.md
HISHAB_ENCRYPT_WORKSPACES=false
